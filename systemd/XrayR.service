[Unit]
Description=XrayR-KOJO Service
Documentation=https://github.com/nbbk/XrayR-KOJO
After=network-online.target nss-lookup.target
Wants=network-online.target

[Service]
User=root
Group=root
Type=simple
WorkingDirectory=/usr/local/XrayR/
ExecStart=/usr/local/XrayR/XrayR --config /etc/XrayR/config.yml
Restart=on-failure
RestartSec=10s
LimitAS=infinity
LimitRSS=infinity
LimitCORE=infinity
LimitNOFILE=999999

[Install]
WantedBy=multi-user.target
